# Copy to .env and supply your own values. Never commit .env.
OAPI_ENV=development

# Database connection
PB_EMAIL=
PB_PASSWORD=
PB_URL=

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URL=http://127.0.0.1:3000/api/auth/callback
# Required: generate a cryptographically random secret (at least 32 bytes).
JWT_SECRET=
# Optional: separate random secret for trusted server calls (full administrator access).
# Never use a PUBLIC_ variable or expose this key in browser code.
OAPI_SERVICE_API_KEY=
RUST_LOG=info,OAPI=debug,tower_http=debug
